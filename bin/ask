#!/usr/bin/env bash

# Ask - Send a non-interactive prompt to GitHub Copilot CLI using GPT-4.1
# Usage: ask "your question here"

set -e

# Check if a prompt was provided
if [ -z "$1" ]; then
    echo "Usage: ask \"your question here\"" >&2
    exit 1
fi

# Combine all arguments into a single prompt
PROMPT="$*"

# Check if GitHub Copilot CLI is installed
if ! copilot --version &> /dev/null; then
    echo "Error: GitHub Copilot CLI extension is not installed." >&2
    echo "Install it with: extension install github/gh-copilot" >&2
    exit 1
fi

# Execute prompt in non-interactive mode with GPT-4.1, read-only, no permissions
copilot --prompt "$PROMPT" \
    --model gpt-4.1 \
    --no-ask-user \
    --silent \
    --excluded-tools "write,shell,git"
