#!/bin/bash
set -euo pipefail

INSTALL_DIR="$HOME/.local/share/openchamber"
VERSION_FILE="$INSTALL_DIR/.version"
APPIMAGE="$INSTALL_DIR/OpenChamber.AppImage"
LAUNCHER="$HOME/.local/bin/openchamber"

LATEST_TAG=$(curl -s https://api.github.com/repos/openchamber/openchamber/releases/latest | python3 -c "import sys,json; print(json.load(sys.stdin)['tag_name'].lstrip('v'))")
if [[ -z "$LATEST_TAG" ]]; then
  echo "ERROR: could not determine latest version from GitHub API" >&2
  echo "Check your internet connection or API rate limit." >&2
  exit 1
fi

if [[ -f "$VERSION_FILE" ]]; then
  INSTALLED=$(<"$VERSION_FILE")
  if [[ "$INSTALLED" == "$LATEST_TAG" ]]; then
    echo "OpenChamber v$INSTALLED is up to date."
    exit 0
  fi
  echo "Updating OpenChamber v$INSTALLED -> v$LATEST_TAG"
else
  echo "Installing OpenChamber v$LATEST_TAG"
fi

ARCH=$(uname -m)
case "$ARCH" in
  x86_64)         apparch=x86_64 ;;
  aarch64|arm64)  apparch=arm64 ;;
  *)              echo "Unsupported arch: $ARCH"; exit 1 ;;
esac

TMPDIR=$(mktemp -d)
trap 'rm -rf "$TMPDIR"' EXIT

URL="https://github.com/openchamber/openchamber/releases/download/v${LATEST_TAG}/OpenChamber-${LATEST_TAG}-linux-${apparch}.AppImage"
echo "Downloading OpenChamber-${LATEST_TAG}-linux-${apparch}.AppImage ..."
curl -fL -o "$TMPDIR/openchamber.AppImage" "$URL"
SIZE=$(stat -c%s "$TMPDIR/openchamber.AppImage" 2>/dev/null || echo 0)
if [[ "$SIZE" -lt 50000000 ]]; then
  echo "ERROR: downloaded file seems too small (${SIZE} bytes). Corrupt or wrong URL?" >&2
  exit 1
fi

# Verify sha512 against electron-updater metadata (same source in-app updates use)
META=$(curl -sL "https://github.com/openchamber/openchamber/releases/download/v${LATEST_TAG}/latest-linux.yml" || true)
if [[ -n "$META" ]] && command -v sha512sum &>/dev/null && command -v base64 &>/dev/null; then
  EXPECTED_B64=$(printf '%s\n' "$META" | sed -n 's/^sha512: *//p' | head -n1)
  if [[ -n "$EXPECTED_B64" ]] && command -v xxd &>/dev/null; then
    ACTUAL_HEX=$(sha512sum "$TMPDIR/openchamber.AppImage" | awk '{print $1}')
    ACTUAL_B64=$(printf '%s' "$ACTUAL_HEX" | xxd -r -p | base64 -w0)
    if [[ "$ACTUAL_B64" != "$EXPECTED_B64" ]]; then
      echo "ERROR: sha512 mismatch; download is corrupt." >&2
      exit 1
    fi
    echo "sha512 verified."
  fi
fi

chmod +x "$TMPDIR/openchamber.AppImage"

# Install the AppImage into a writable location so in-app updates can replace it
mkdir -p "$INSTALL_DIR"
install -m 755 "$TMPDIR/openchamber.AppImage" "$APPIMAGE"
echo "$LATEST_TAG" > "$VERSION_FILE"

# Launcher wrapper
mkdir -p "$HOME/.local/bin"
cat > "$LAUNCHER" <<'EOF'
#!/bin/bash
XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
if [[ -f "$XDG_CONFIG_HOME/openchamber-flags.conf" ]]; then
  OPENCHAMBER_USER_FLAGS="$(grep -v '^#' "$XDG_CONFIG_HOME/openchamber-flags.conf")"
fi
exec "$HOME/.local/share/openchamber/OpenChamber.AppImage" $OPENCHAMBER_USER_FLAGS "$@"
EOF
chmod +x "$LAUNCHER"

# Extract desktop entry and icons from the AppImage (works without FUSE)
(
  cd "$TMPDIR"
  "$TMPDIR/openchamber.AppImage" --appimage-extract '*.desktop' >/dev/null 2>&1 || true
  "$TMPDIR/openchamber.AppImage" --appimage-extract 'usr/share/icons/*' >/dev/null 2>&1 || true
)

# Install desktop entry, pointing Exec at the launcher
shopt -s nullglob
for f in "$TMPDIR"/squashfs-root/*.desktop; do
  mkdir -p "$HOME/.local/share/applications"
  sed -e 's|^Exec=.*|Exec='"$LAUNCHER"'|' \
      -e 's|^TryExec=.*|TryExec='"$LAUNCHER"'|' \
      "$f" > "$HOME/.local/share/applications/$(basename "$f")"
  echo "Installed desktop entry $(basename "$f")"
done

# Install icons
if [[ -d "$TMPDIR/squashfs-root/usr/share/icons" ]]; then
  mkdir -p "$HOME/.local/share/icons"
  cp -r "$TMPDIR/squashfs-root/usr/share/icons/." "$HOME/.local/share/icons/"
fi

# Update icon cache (non-fatal)
if command -v gtk-update-icon-cache &>/dev/null; then
  gtk-update-icon-cache -f "$HOME/.local/share/icons/hicolor" 2>/dev/null || true
fi

echo "Done! Installed OpenChamber v$LATEST_TAG"